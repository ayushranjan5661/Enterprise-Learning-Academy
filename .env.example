MISTRAL_API_KEY=your_key_here
CHROMA_PERSIST_DIR=./data/chroma_db
RUNS_DIR=./data/runs

# Archive of human-approved programmes. Defaults to SQLite under ./data, which is fine
# locally. On a host with an ephemeral filesystem (Render free tier) that file is destroyed
# on every restart — point this at a managed Postgres (Neon, Supabase) to actually keep them.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Re-embed sample_materials/ at startup when the vector store is empty. Leave false locally.
SEED_ON_BOOT=false
LLM_MODEL_LARGE=mistral-large-latest
LLM_MODEL_SMALL=mistral-small-latest
EMBED_MODEL=mistral-embed
MAX_REVISIONS=3
MAX_HUMAN_REJECTIONS=2
RAG_TOP_K=3

# Retry policy. Rate limits (429) get their own, far more patient budget:
# an ordinary error fails fast, a capacity error is worth waiting out.
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_SECONDS=2
LLM_RATE_LIMIT_ATTEMPTS=5
LLM_RATE_LIMIT_BACKOFF_SECONDS=10
LLM_RATE_LIMIT_MAX_BACKOFF_SECONDS=90
