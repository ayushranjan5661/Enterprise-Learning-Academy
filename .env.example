MISTRAL_API_KEY=your_key_here
CHROMA_PERSIST_DIR=./data/chroma_db
RUNS_DIR=./data/runs
LLM_MODEL_LARGE=mistral-large-latest
LLM_MODEL_SMALL=mistral-small-latest
EMBED_MODEL=mistral-embed
MAX_REVISIONS=3
MAX_HUMAN_REJECTIONS=2
RAG_TOP_K=3

# Retry policy. Rate limits (429) get their own, far more patient budget:
# an ordinary error fails fast, a capacity error is worth waiting out.
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_SECONDS=2
LLM_RATE_LIMIT_ATTEMPTS=5
LLM_RATE_LIMIT_BACKOFF_SECONDS=10
LLM_RATE_LIMIT_MAX_BACKOFF_SECONDS=90
